/* ============================================================
   ZPP011 亮色主题 LIGHT THEME (2026-10-26 现代化改版)
   ------------------------------------------------------------
   调色板（真源 gui_pyside6/themes/tokens.py，本文件只允许出现令牌取值；
   tests/unit/test_design_tokens.py 会逐色号校验，写入表外颜色即失败）：
     窗口底 #EEF1F6 · 面板 #FFFFFF · 描边 #DBE2EC/#C0CCDA · 正文 #101828
     次文 #5A6B82 · 主色 #1E40AF（按下 #1A3478 · 浅底 #E7EDFB）
     语义 危险 #C62A2A 提醒 #C2740B 信息 #2563EB 成功 #0E8F63
   约定：控件侧只写 objectName / setProperty("class",...)，禁止内联
         setStyleSheet 写死颜色，否则切暗色主题会失配（历史上工具栏
         在暗色下几乎看不见就是这么来的）。
   ============================================================ */

/* ── 全局 ── */
QMainWindow, QDialog, QWidget {
    background-color: #EEF1F6;
    color: #101828;
    font-family: "Segoe UI","Microsoft YaHei UI","Microsoft YaHei";
    font-size: 12px;
}
/* QLabel 默认必须是透明底：上面那条 QWidget 规则会让每个标签自己刷一层窗口底
   #EEF1F6，于是白底面板（标题栏 / 操作栏 / 卡片）上的文字后面全是灰方块，
   Tier 分层被糊掉。需要底色的标签（状态胶囊、KPI 卡）都有各自的 id/class 规则，
   特异性更高，不受这条影响。 */
QLabel { background-color: transparent; }

/* ── 标题栏 TitleBarWidget（v43.349 第五期第 1 项：设计稿 Tier 1 四段式）──
   品牌块 │ 竖分隔 │ 数据上下文（本次分析时间）│ 右端胶囊（数据源 / 暗色）
   旧的 #titleAccentBar（4px 深蓝竖条）与 #titleSub（数据源｜分析时间一行小字）
   已随组件重写删除 —— 数据上下文改由胶囊 + 数值承载。 */
#titleBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #DBE2EC;
}
#titleBrand {
    background-color: #1E40AF;
    border-radius: 6px;
}
#titleMain {
    color: #101828;
    font-size: 14px;
    font-weight: 600;
}
#titleBrandSub {
    color: #8595AA;
    font-size: 11px;
}
#titleSep {
    background-color: #DBE2EC;
}
#titleCtx {
    color: #5A6B82;
    font-size: 12px;
}
#titleCtxValue {
    color: #101828;
    font-size: 12px;
    font-weight: 600;
    font-family: "Cascadia Mono","Consolas";
}
/* 右端胶囊（设计稿 .factory：28 高 · 4px 圆角 · surface2 底 · 12px/600） */
#titleSourceBtn, #themeBtn {
    background-color: #F5F8FC;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 4px;
    padding: 0 9px;
    font-size: 12px;
    font-weight: 600;
}
#titleSourceBtn:hover, #themeBtn:hover {
    background-color: #E7EDFB;
    border-color: #C3D3F4;
    color: #1E3A8A;
}
#titleSourceBtn:pressed, #themeBtn:pressed {
    background-color: #E9EEF5;
    color: #1A3478;
}
#titleLabel {
    color: #101828;
    font-size: 14px;
    font-weight: 500;
}
#factoryLabel, #dateLabel, #dateSep, #searchLabel, #previewLabel, .filterLabel {
    color: #5A6B82;
    font-size: 11px;
}
#factoryCombo {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11px;
}
#factoryCombo:hover { border-color: #C0CCDA; }
#factoryCombo QAbstractItemView {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 6px;
    selection-background-color: #E7EDFB;
    selection-color: #101828;
}

/* 窗口控制按钮 */
.windowBtn {
    background-color: transparent;
    color: #5A6B82;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 12px;
    padding: 4px 8px;
}
.windowBtn:hover { background-color: #E9EEF5; color: #101828; }

/* ── 操作栏 Action Bar ── */
/* 设计稿 .action-bar：底色 surface-2，比标题栏（surface）低一档，形成 Tier 分层 */
#actionBar {
    background-color: #F5F8FC;
    border-bottom: 1px solid #DBE2EC;
}
.actionBtn {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 5px 12px;
    font-size: 11px;
}
.actionBtn:hover { background-color: #E7EDFB; border-color: #C3D3F4; color: #1E3A8A; }
.actionBtn:checked { background-color: #1E40AF; border-color: #1E40AF; color: #FFFFFF; }
/* v43.349 第五期B：操作栏三段分层，尺寸/圆角/字号全部对齐设计稿 .btn/.tool-btn/.hint */
#actionBtnAnalyze {
    background-color: #1E40AF;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 0 11px;
    font-size: 12px;
    font-weight: 600;
}
#actionBtnAnalyze:hover { background-color: #1E3A8A; }
#actionBtnAnalyze:pressed { background-color: #1A3478; }
#actionBtnAnalyze:disabled { background-color: #E9EEF5; color: #8595AA; }
/* 第 1 段第二颗：描边按钮（设计稿 .btn-outline） */
QToolButton#actionBtnAudit {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #C0CCDA;
    border-radius: 6px;
    padding: 0 11px;
    font-size: 12px;
    font-weight: 600;
}
QToolButton#actionBtnAudit:hover {
    background-color: #E7EDFB;
    border-color: #C3D3F4;
    color: #1E3A8A;
}
QToolButton#actionBtnAudit:pressed { background-color: #C3D3F4; }
QToolButton#actionBtnAudit:disabled { color: #8595AA; border-color: #DBE2EC; }
/* 第 2 段：icon-only 视图开关 + ⋮更多（设计稿 .tool-btn / .tool-btn.on） */
QToolButton#toolViewBtn {
    background-color: transparent;
    color: #5A6B82;
    border: 1px solid transparent;
    border-radius: 6px;
}
QToolButton#toolViewBtn:hover { background-color: #E9EEF5; color: #101828; }
QToolButton#toolViewBtn:checked {
    background-color: #E7EDFB;
    border-color: #C3D3F4;
    color: #1E3A8A;
}
QToolButton#toolViewBtn:disabled { color: #8595AA; }
/* 右端提示：共 N 条 · 快捷键胶囊（设计稿 .hint / .kbd） */
#actionHintText {
    color: #8595AA;
    font-size: 11px;
}
#actionHintCount {
    color: #101828;
    font-size: 11px;
    font-weight: 600;
    font-family: "Cascadia Mono", "Consolas";
}
#kbdChip {
    background-color: #FFFFFF;
    color: #5A6B82;
    border: 1px solid #C0CCDA;
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 10px;
    font-family: "Cascadia Mono", "Consolas";
}
#actionBtnAi {
    background-color: #0E8F63;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 5px 18px;
    font-size: 12px;
    font-weight: 600;
}
#actionBtnAi:hover { background-color: #0B7355; }
#actionBtnDate {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 5px 12px;
    font-size: 11px;
}
#actionBtnDate:hover { background-color: #E7EDFB; border-color: #C3D3F4; color: #1E3A8A; }
.spacer { background: transparent; }

/* 工具栏里的「幽灵按钮」：视图开关/收纳菜单/面板开关/未读/自动隔离。
   代码侧只保留 objectName=toolGhostBtn（或 class），样式全部在此。 */
QToolButton#toolGhostBtn, .toolGhost {
    background-color: transparent;
    color: #5A6B82;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 4px 10px;
    font-size: 12px;
}
QToolButton#toolGhostBtn:hover, .toolGhost:hover {
    background-color: #E7EDFB;
    border-color: #C3D3F4;
    color: #1E3A8A;
}
QToolButton#toolGhostBtn:pressed, .toolGhost:pressed { background-color: #C3D3F4; }
QToolButton#toolGhostBtn:checked, .toolGhost:checked {
    background-color: #E7EDFB;
    border-color: #C3D3F4;
    color: #1E3A8A;
    font-weight: 600;
}
QToolButton#toolGhostBtn:disabled, .toolGhost:disabled { color: #8595AA; }
QToolButton#toolGhostBtn::menu-indicator { width: 0; height: 0; }

/* 看板对话框「列头筛选」按钮（v43.264 共用组件 col_filter_ui，幽灵风格） */
QPushButton#btn_col_filter, QPushButton#btn_col_filter_expired {
    background-color: transparent;
    color: #5A6B82;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#btn_col_filter:hover, QPushButton#btn_col_filter_expired:hover {
    background-color: #E7EDFB; border-color: #C3D3F4; color: #1E3A8A;
}
QPushButton#btn_col_filter:checked, QPushButton#btn_col_filter_expired:checked {
    background-color: #C3D3F4; border-color: #C3D3F4; color: #1E3A8A; font-weight: 600;
}


/* 工具栏收纳菜单按钮（看板/导出）：设计稿 .btn-ghost，透明底 + muted 墨色 */
QToolButton#actionMenuBtn {
    background-color: transparent;
    color: #5A6B82;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 0 11px;
    font-size: 12px;
    font-weight: 600;
}
QToolButton#actionMenuBtn:hover { background-color: #E9EEF5; color: #101828; }
QToolButton#actionMenuBtn:pressed { background-color: #E9EEF5; }
QToolButton#actionMenuBtn:disabled { color: #8595AA; }
QToolButton#actionMenuBtn::menu-indicator { width: 0; height: 0; }
#toolbarSep { background-color: #C0CCDA; }

/* ── 输入框 ── */
.inputEdit, #startDateEdit, #endDateEdit,
#inputFileEdit, #outputDirEdit {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 5px 10px;
    font-size: 11px;
    font-family: "Segoe UI","Microsoft YaHei UI","Microsoft YaHei";
}
.inputEdit:hover, #startDateEdit:hover, #endDateEdit:hover { border-color: #C0CCDA; }
.inputEdit:focus, #startDateEdit:focus, #endDateEdit:focus {
    border-color: #1E40AF;
    background-color: #F5F8FC;
}
/* 侧边栏通用输入（left_panel 建的 <标签>Input，历史上写死暗色值） */
QLineEdit#inputFileEdit, QLineEdit#outputDirEdit {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 5px 10px;
    font-size: 11px;
}
QLineEdit#inputFileEdit:focus, QLineEdit#outputDirEdit:focus {
    border-color: #1E40AF;
    background-color: #F5F8FC;
}

/* ── 下拉框（侧边栏通用） ── */
.comboStyle {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 4px 8px;
    font-size: 11px;
    font-family: "Segoe UI","Microsoft YaHei UI","Microsoft YaHei";
}
.comboStyle:hover { border-color: #C0CCDA; }
.comboStyle QAbstractItemView {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 6px;
    selection-background-color: #E7EDFB;
    selection-color: #101828;
}

/* ── Tier 3 左侧导航栏（v43.349 第五期C，设计稿 .sidebar / .nav-item / .count）──
   旧「卡片式分组」规则（#cardContainer/#cardStripe/#cardHeader/#cardTitle/#cardBody/
   #collapseArrow/#collapsible*）随左栏改纯导航一并删除：代码侧已无产出点。 */
#leftPanel {
    background-color: #FFFFFF;
    border-right: 1px solid #DBE2EC;
}
#sideSec { background-color: transparent; }
#sideFoot {
    background-color: transparent;
    border-top: 1px solid #DBE2EC;
}
#sideLabel {
    color: #8595AA;
    font-size: 11px;
    font-weight: 600;
    padding: 0 6px 6px 6px;
}
/* 设计稿 .nav-item：30 高 · r-md 6 · 左对齐 · 12.5px 次文色 */
QPushButton#navItem {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 0 8px;
    text-align: left;
    color: #5A6B82;
    font-size: 12px;
}
QPushButton#navItem:hover {
    background-color: #E9EEF5;
    color: #101828;
}
/* [navOn] = 当前工作区（.nav-item.on）；:checked = 表单展开中，同一档高亮 */
QPushButton#navItem[navOn="true"],
QPushButton#navItem:checked {
    background-color: #E7EDFB;
    color: #1E3A8A;
    font-weight: 600;
}
/* 设计稿 .count：数字胶囊；.count.alert（未读>0）换成 danger 档 */
QLabel#navCount {
    background-color: #E9EEF5;
    color: #5A6B82;
    border-radius: 9px;
    padding: 1px 6px;
    font-size: 11px;
    font-weight: 600;
    font-family: "Cascadia Mono", "Consolas";
}
QLabel#navCount[alert="true"] {
    background-color: #FBEAEA;
    color: #C62A2A;
}
#navBody { background-color: transparent; }

/* ── 侧边栏筛选面板 ── */
#filterGroup, #altGroup, #quickGroup, #filterTitleLabel {
    color: #5A6B82;
    font-size: 12px;
    font-weight: 600;
    border: none;
}
#altCountLabel {
    color: #5A6B82;
    font-size: 11px;
}
#browseBtn {
    background-color: #1E40AF;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 5px 14px;
    font-size: 11px;
    font-weight: 600;
}
#browseBtn:hover { background-color: #1E3A8A; }
#altActionBtn {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 5px 12px;
    font-size: 11px;
}
#altActionBtn:hover { background-color: #E7EDFB; border-color: #C3D3F4; color: #1E3A8A; }
.filterBtn, .quickBtn {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 5px 12px;
    font-size: 11px;
    font-family: "Segoe UI","Microsoft YaHei UI","Microsoft YaHei";
}
.filterBtn:hover, .quickBtn:hover { background-color: #E7EDFB; border-color: #C3D3F4; color: #1E3A8A; }
QLabel#dialogTipLabel, QLabel#filterNoteLabel {
    color: #8595AA;
    font-size: 11px;
}

/* ── 替代料表格 ── */
#altTable {
    background-color: #FFFFFF;
    color: #101828;
    alternate-background-color: #F5F8FC;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    font-size: 11px;
    gridline-color: #DBE2EC;
    selection-background-color: #C3D3F4;
    selection-color: #101828;
}
#altTable::item { padding: 3px 6px; border: none; }
#altTable::item:selected { background-color: #C3D3F4; color: #101828; }

/* ── 日志面板 ── */
#logGroup {
    color: #5A6B82;
    font-size: 12px;
    font-weight: 600;
    border: none;
}
#logTextEdit {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    font-size: 11px;
    font-family: "Cascadia Mono","Consolas";
    padding: 6px;
}

/* ── 菜单栏 / 右键菜单 ── */
QMenuBar {
    background-color: #FFFFFF;
    color: #101828;
    border-bottom: 1px solid #DBE2EC;
    font-size: 12px;
    padding: 2px;
}
QMenuBar::item { padding: 4px 10px; border-radius: 6px; }
QMenuBar::item:selected { background-color: #E7EDFB; color: #1E3A8A; }
QMenu {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 5px;
    font-size: 12px;
}
QMenu::item { padding: 6px 22px 6px 14px; border-radius: 6px; }
QMenu::item:selected { background-color: #E7EDFB; color: #1E3A8A; }
QMenu::item:disabled { color: #8595AA; }
QMenu::separator { height: 1px; background-color: #DBE2EC; margin: 5px 8px; }

/* ── 主表格（v43.349 第五期E：照抄设计稿 .tbl —— 36px 行 / 32px 单行表头 /
      无竖网格线 + 每行 1px 下边框 / 数值列等宽右对齐由模型角色负责 /
      选中浅蓝底 + 左缘 3px 主色条、悬浮行叠色、状态胶囊由 RowStyleDelegate 叠画）── */
#tableView {
    background-color: #FFFFFF;
    color: #101828;
    alternate-background-color: #F5F8FC;
    gridline-color: #DBE2EC;
    border: 1px solid #DBE2EC;
    border-radius: 6px;
    font-size: 12px;
    font-family: "Segoe UI","Microsoft YaHei UI","Microsoft YaHei";
    selection-background-color: #E7EDFB;
    selection-color: #101828;
}
/* v43.351 第五期G2：主表右端并排放了 74px 悬浮操作道（RowActionLane，设计稿 .rowact）。
   道不是列，只能与表格并排，所以边框改由外壳画一圈，把两块围成同一张表。
   只命中壳里的表格，其它地方的 #tableView 仍用上面那条带边框的规则。 */
#tableShell {
    background-color: #FFFFFF;
    border: 1px solid #DBE2EC;
    border-radius: 6px;
}
#tableShell > #tableView { border: none; border-radius: 0; }
#rowActionLane { background-color: #FFFFFF; border: none; }
#tableView::item { padding: 0 10px; border: none; border-bottom: 1px solid #DBE2EC; }
#tableView::item:selected { background-color: #E7EDFB; color: #101828; }
#tableView::item:selected:!active { background-color: #E7EDFB; color: #101828; }
#tableView QHeaderView::section {
    background-color: #F5F8FC;
    color: #5A6B82;
    border: none;
    border-right: 1px solid #DBE2EC;
    border-bottom: 1px solid #C0CCDA;
    font-weight: 600;
    font-size: 11px;
}
/* 横向表头左侧留 20px：SortBadgeHeader 把筛选漏斗角标画在 section.left()+2 起 18px 宽 */
#tableView QHeaderView::section:horizontal { padding: 0 8px 0 20px; }
#tableView QHeaderView::section:vertical { padding: 0 6px; }
#tableView QHeaderView::section:horizontal:hover {
    background-color: #E7EDFB;
    color: #1E3A8A;
}
QHeaderView::section#altTable {
    background-color: #F5F8FC;
    color: #5A6B82;
    border: none;
    border-bottom: 1px solid #DBE2EC;
    padding: 5px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* ── 进度条 ── */
#progressBar {
    background-color: #E9EEF5;
    border: none;
    border-radius: 6px;
    text-align: center;
    font-size: 11px;
    color: #FFFFFF;
}
#progressBar::chunk {
    background-color: #1E40AF;
    border-radius: 6px;
}
#progressGroup {
    color: #5A6B82;
    font-size: 12px;
    font-weight: 600;
    border: none;
}
#progressContent {
    background-color: #FFFFFF;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
}
#progressLabel {
    font-size: 12px;
    color: #5A6B82;
    font-weight: 600;
}
#timerLabel {
    color: #5A6B82;
    font-family: "Cascadia Mono","Consolas";
    font-size: 12px;
    font-weight: 600;
}
/* 分析步骤图标（1..8 → √），active/done 由代码 setProperty 驱动 */
QToolButton#stepIcon {
    color: #8595AA;
    background-color: #E9EEF5;
    border: 1px solid #DBE2EC;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0px;
}
QToolButton#stepIcon:hover { background-color: #E7EDFB; border-color: #C3D3F4; color: #1E3A8A; }
QToolButton#stepIcon[active="true"] {
    color: #FFFFFF;
    background-color: #1E40AF;
    border-color: #1E40AF;
}
QToolButton#stepIcon[done="true"] {
    color: #1E3A8A;
    background-color: #E7EDFB;
    border-color: #C3D3F4;
}

/* ── 统计组 ── */
#statsGroup, #actionGroup {
    color: #5A6B82;
    font-size: 12px;
    font-weight: 600;
    border: none;
}
#startBtn {
    background-color: #1E40AF;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 5px 18px;
    font-size: 12px;
    font-weight: 600;
}
#startBtn:hover { background-color: #1E3A8A; }
#cancelBtn, #openDirBtn, #pptBtn, #excelBtn, #exportFullBtn, #refreshNetBtn {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 5px 12px;
    font-size: 11px;
}
#cancelBtn:hover, #openDirBtn:hover, #pptBtn:hover, #excelBtn:hover,
#exportFullBtn:hover, #refreshNetBtn:hover {
    background-color: #E7EDFB;
    border-color: #C3D3F4;
    color: #1E3A8A;
}

/* ── 合计栏 ── */
#summaryContainer {
    background-color: #FFFFFF;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
}
#markStatsLabel {
    padding: 3px 10px;
    border-radius: 6px;
    background-color: #E9EEF5;
    border: 1px solid #DBE2EC;
    color: #101828;
    font-size: 11px;
}
#unitSummaryBtn, #lockBtn, #fullscreenBtn {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 5px 12px;
    font-size: 11px;
}
#unitSummaryBtn:hover, #lockBtn:hover, #fullscreenBtn:hover {
    background-color: #E7EDFB;
    border-color: #C3D3F4;
    color: #1E3A8A;
}

/* ── KPI 概览带（v43.349 第五期D：照抄设计稿 .kpi-bar，54px 等高带）──
   带本身只有一条下边框 + 格间 1px 竖线，格子无描边无圆角，hover 换 surface-2。 */
#statsCardsContainer {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #DBE2EC;
}
#statsCard { background-color: transparent; border: none; }
#statsCard:hover { background-color: #F5F8FC; }
#kpiDivider { background-color: #DBE2EC; border: none; }
#kpiDot { border: none; border-radius: 3px; }
QFrame#kpiDot[kpiAccent="pass"] { background-color: #0E8F63; }
QFrame#kpiDot[kpiAccent="unread"] { background-color: #2563EB; }
QFrame#kpiDot[kpiAccent="anomaly"] { background-color: #C62A2A; }
QFrame#kpiDot[kpiAccent="alt"] { background-color: #6D28D9; }
QFrame#kpiDot[kpiAccent="changed"] { background-color: #C2740B; }
QFrame#kpiDot[kpiAccent="quarantine"] { background-color: #8595AA; }
QFrame#kpiDot[kpiAccent="deviation"] { background-color: #C2740B; }
QLabel#kpiLabel {
    color: #5A6B82;
    font-size: 11px;
}
QLabel#kpiValue {
    color: #101828;
    font-size: 17px;
    font-weight: 600;
    font-family: "Cascadia Mono","Consolas";
}
QLabel#kpiUnit {
    color: #5A6B82;
    font-size: 11px;
}
/* 面板小标题（分析进度标题行仍在用；KPI 带按设计稿没有标题行） */
.statsCardTitle {
    font-size: 12px;
    font-weight: 600;
    color: #5A6B82;
}

/* ── 状态栏（v43.349 第五期F：设计稿 .status-bar 单行 30px。
      左半 = 高频指标：状态点 + 状态文字 + 已选/共 + 偏差合计 + 未读；
      右半 = 低频信息：分析时刻 / 已读计数 / 列头筛选 / 版本号（addPermanentWidget）。
      改造前这条与原生 QStatusBar 叠成两条，现在本组件就是主窗口唯一的 QStatusBar）── */
QStatusBar, QWidget#bottomStatusBar {
    background-color: #F5F8FC;
    color: #5A6B82;
    border-top: 1px solid #DBE2EC;
    font-size: 12px;
}
QStatusBar::item { border: none; }
/* 指标容器是裸 QWidget：全局规则会给它们刷 bg，必须显式透明，否则整行变灰块 */
QWidget#bottomStatusRow, QWidget#bottomStatusItem { background-color: transparent; }
QLabel#bottomStatusLabel {
    color: #5A6B82;
    font-size: 12px;
}
QLabel#bottomStatusValue {
    color: #101828;
    font-size: 12px;
    font-weight: 600;
    font-family: "Cascadia Mono","Consolas";
}
QLabel#bottomStatusValue[sign="neg"] { color: #0E8F63; }   /* 节约 绿 */
QLabel#bottomStatusValue[sign="pos"] { color: #C62A2A; }   /* 超投 红 */
/* 状态点：7px 实心 + 3px 同色淡环（设计稿 .status-dot） */
QFrame#statusDot {
    border-radius: 6px;
    background-color: #8595AA;
    border: 3px solid #E9EEF5;
}
QFrame#statusDot[dotState="ok"] {
    background-color: #0E8F63;
    border: 3px solid #E3F5EE;
}
QFrame#statusDot[dotState="warn"] {
    background-color: #C2740B;
    border: 3px solid #FDF3E3;
}
QLabel#analysisTimeLabel, QLabel#readCounterLabel, QLabel#colFilterHintLabel {
    padding: 2px 10px;
    font-weight: 600;
    border-left: 1px solid #DBE2EC;
}
QLabel#analysisTimeLabel, QLabel#colFilterHintLabel { color: #C2740B; }
QLabel#readCounterLabel { color: #2563EB; }
/* v43.349 第五期A：版本号从标题栏主标题移到这里（设计稿 .status-right 低频信息右置） */
QLabel#versionLabel {
    color: #8595AA;
    padding: 2px 10px;
    border-left: 1px solid #DBE2EC;
    font-family: "Cascadia Mono","Consolas";
}

/* ── 对话框 ── */
#aboutDialog {
    background-color: #FFFFFF;
    color: #101828;
}
#aboutInfoFrame {
    background-color: #F5F8FC;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
}
#aboutTitle {
    color: #101828;
    font-size: 17px;
    font-weight: 700;
}
#aboutDesc {
    color: #5A6B82;
    font-size: 12px;
    padding-top: 8px;
}
#aboutAuthor {
    color: #5A6B82;
    font-size: 12px;
}
#aboutSectionLabel {
    color: #101828;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 28px 4px;
}
#versionLogBrowser {
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    background-color: #F5F8FC;
    padding: 8px;
}
#aboutBtnFrame {
    background-color: #F5F8FC;
    border-top: 1px solid #DBE2EC;
}
#aboutCloseBtn {
    background-color: #1E40AF;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 6px 24px;
    font-weight: 600;
}
#aboutCloseBtn:hover { background-color: #1E3A8A; }

/* ── Toast / Alert ── */
#toastWidget {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 8px 16px;
}
#alertPopup {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
}
#alertDetail {
    background-color: #F5F8FC;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 6px;
}

/* ── Loading 对话框 ── */
#loadingLabel {
    font-size: 14px;
    font-weight: 600;
    color: #1E3A8A;
}
#loadingProgress {
    background-color: #E9EEF5;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #FFFFFF;
}
#loadingProgress::chunk {
    background-color: #1E40AF;
    border-radius: 6px;
}

/* ── 联动横幅（看板钻取到主表，可一键清除） ── */
QFrame#linkBanner {
    background: #E7EDFB;
    border: 1px solid #C3D3F4;
    border-radius: 10px;
    margin: 4px 4px 0px 4px;
}
QLabel#linkBannerLabel {
    color: #1E40AF;
    font-size: 12px;
    background: transparent;
}
QPushButton#linkBannerClearBtn {
    color: #FFFFFF;
    background: #1E40AF;
    border: none;
    border-radius: 6px;
    padding: 3px 12px;
    font-size: 12px;
}
QPushButton#linkBannerClearBtn:hover { background: #1E3A8A; }

/* 筛选面板「预设」按钮（与工具栏按钮观感一致） */
QPushButton#filterPresetBtn {
    color: #101828;
    background: #FFFFFF;
    border: 1px solid #DBE2EC;
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 11px;
}
QPushButton#filterPresetBtn:hover { background: #E7EDFB; border-color: #C3D3F4; color: #1E3A8A; }

/* ── 滚动条 ── */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    border: none;
    margin: 2px 1px 2px 0;
}
QScrollBar::handle:vertical {
    background-color: #C0CCDA;
    border-radius: 4px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover { background-color: #C3D3F4; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    border: none;
    margin: 0 2px 1px 2px;
}
QScrollBar::handle:horizontal {
    background-color: #C0CCDA;
    border-radius: 4px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover { background-color: #C3D3F4; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

/* ── 提示气泡 ── */
QToolTip {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 6px;
    padding: 5px 8px;
}

/* 左侧面板与表单标签：原由内联 color:#ffffff 强制，亮色主题下不可见。
   统一交给主题控制，代码侧只保留 objectName。 */
#filterLabel, #semiCountLabel {
    color: #101828;
    font-size: 11px;
}

/* ════════════════════════════════════════════════════════════
   通用控件基样式（对话框 / 看板 / 弹窗）
   ────────────────────────────────────────────────────────────
   这些控件在代码里没有 objectName，之前完全靠 Fusion 原生外观，
   暗色主题下会出现「深色面板 + 白色控件」的拼贴感。统一在这里兜底；
   专用控件的 objectName / class 规则优先级更高，不受影响。
   ════════════════════════════════════════════════════════════ */
QDialog, QMessageBox, QFileDialog {
    background-color: #EEF1F6;
    color: #101828;
}

QPushButton {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 5px 14px;
    font-size: 12px;
}
QPushButton:hover { background-color: #E7EDFB; border-color: #C3D3F4; color: #1E3A8A; }
QPushButton:pressed { background-color: #C3D3F4; border-color: #C3D3F4; color: #1E40AF; }
QPushButton:checked { background-color: #E7EDFB; border-color: #C3D3F4; color: #1E3A8A; font-weight: 600; }
QPushButton:selected { background-color: #C3D3F4; color: #101828; }
QPushButton:default { border-color: #1E40AF; color: #1E3A8A; font-weight: 600; }
QPushButton:disabled { background-color: #E9EEF5; color: #8595AA; border-color: #DBE2EC; }

QToolButton {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 4px 10px;
    font-size: 12px;
}
QToolButton:hover { background-color: #E7EDFB; border-color: #C3D3F4; color: #1E3A8A; }
QToolButton:pressed { background-color: #C3D3F4; border-color: #C3D3F4; }
QToolButton:checked { background-color: #E7EDFB; border-color: #C3D3F4; color: #1E3A8A; font-weight: 600; }
QToolButton:disabled { background-color: #E9EEF5; color: #8595AA; border-color: #DBE2EC; }
QToolButton::menu-indicator { subcontrol-position: right center; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 4px 8px;
    selection-background-color: #C3D3F4;
    selection-color: #101828;
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover { border-color: #C0CCDA; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #1E40AF;
    background-color: #F5F8FC;
}
QTextEdit, QPlainTextEdit { padding: 6px 8px; }

QDateEdit, QDateTimeEdit, QTimeEdit, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 3px 8px;
    selection-background-color: #C3D3F4;
    selection-color: #101828;
}
QDateEdit:hover, QDateTimeEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover { border-color: #C0CCDA; }
/* 这里刻意不写 ::drop-down / ::up-button：样式表一旦接管这两个子控件，
   Qt 就不再画原生箭头，下拉框/数字框会变成「看不出能点」的空白条。 */

QComboBox {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 4px 10px;
}
QComboBox:hover { border-color: #C3D3F4; color: #1E3A8A; }
QComboBox:disabled { background-color: #E9EEF5; color: #8595AA; }
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #101828;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    selection-background-color: #E7EDFB;
    selection-color: #1E3A8A;
    outline: none;
    padding: 2px;
}

/* 复选/单选。两个坑（v43.263 实测）：
   1) 只给 QCheckBox 本体配色不写 background；一旦写了 background，Qt 就改用样式表
      画 indicator，原生小方框直接消失（筛选面板「颜色标记」看不见勾就是这么来的）。
   2) 要显式画 indicator，normal / hover / checked / disabled 四个状态必须一次配齐，
      少写一个就会在某档主题下变成「看不见勾」。勾选态用主色实心方块表示。 */
QCheckBox, QRadioButton {
    color: #101828;
    font-size: 12px;
}
QCheckBox:disabled, QRadioButton:disabled { color: #8595AA; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #C0CCDA;
    border-radius: 4px;
    background-color: #FFFFFF;
}
QRadioButton::indicator { border-radius: 10px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #1E40AF; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #1E40AF;
    border-color: #1E40AF;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #E9EEF5;
    border-color: #DBE2EC;
}

QGroupBox {
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    margin-top: 12px;
    padding: 10px 8px 8px 8px;
    background-color: #FFFFFF;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: 2px;
    padding: 0 4px;
    color: #5A6B82;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QTableView, QTableWidget, QListWidget, QListView, QTreeView, QTreeWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F5F8FC;
    color: #101828;
    gridline-color: #DBE2EC;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    selection-background-color: #C3D3F4;
    selection-color: #101828;
    font-size: 12px;
}
QTableView::item, QTableWidget::item, QListWidget::item, QTreeView::item, QTreeWidget::item {
    padding: 3px 6px;
    border: none;
}
QHeaderView::section {
    background-color: #F5F8FC;
    color: #101828;
    border: none;
    border-right: 1px solid #DBE2EC;
    border-bottom: 1px solid #DBE2EC;
    padding: 4px 6px;
    font-weight: 600;
    font-size: 12px;
}
QHeaderView::section:hover { background-color: #E7EDFB; color: #1E3A8A; }
/* 看板最左行号栏（v43.366）：只当刻度，不跟列头抢视觉重量。
   主表那根道（rowCheckLane）整条自绘、不走 QSS，故这里不会影响它。 */
QHeaderView::section:vertical {
    background-color: #F5F8FC;
    color: #5A6B82;
    border: none;
    border-right: 1px solid #DBE2EC;
    padding: 2px 6px;
    font-weight: 400;
    font-size: 11px;
}
QHeaderView::section:vertical:hover { background-color: #F5F8FC; color: #5A6B82; }

QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #5A6B82;
    border: 1px solid transparent;
    border-bottom: none;
    border-radius: 10px 10px 0 0;
    padding: 5px 14px;
    font-size: 12px;
}
QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #1E3A8A;
    border-color: #DBE2EC;
    font-weight: 600;
}
QTabBar::tab:hover:!selected { background-color: #E7EDFB; color: #1E3A8A; }

QScrollArea {
    background-color: transparent;
}

QProgressBar {
    background-color: #E9EEF5;
    border: none;
    border-radius: 6px;
    text-align: center;
    font-size: 11px;
    color: #101828;
    min-height: 16px;
}
QProgressBar::chunk {
    background-color: #1E40AF;
    border-radius: 6px;
}

/* ── 代码侧新移交的主题钩子（原先是内联写死的颜色） ── */
/* 列头筛选浮层标题（utils/column_filter.py、controllers/column_controller.py） */
QLabel#columnFilterTitle {
    color: #2563EB;
    font-size: 12px;
    font-weight: 600;
}
/* 琥珀色提醒：对话框内的「列头筛选：N 列」 */
QLabel.amberHint {
    color: #C2740B;
    font-weight: 600;
    padding: 2px 8px;
}
/* 次级说明文字：看板计数、顶部提示 */
QLabel.mutedText {
    color: #5A6B82;
    font-size: 12px;
}
/* 自动隔离/自动已读规则的「当前规则预览」框 */
QLabel#ruleSummaryLabel {
    color: #101828;
    background-color: #F5F8FC;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
    padding: 8px 10px;
}
/* 物料画像中的异常值 */
QLabel#profileWarnValue {
    color: #C62A2A;
    font-weight: 600;
}
/* 未读汇总弹窗 */
QLabel#unreadSummaryTitle {
    color: #101828;
    font-size: 13px;
    font-weight: 600;
}
QLabel#unreadAllClear {
    color: #0E8F63;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 0 4px 0;
}
QFrame#unreadRow {
    background-color: #F5F8FC;
    border: 1px solid #DBE2EC;
    border-radius: 10px;
}
QLabel#unreadCount {
    color: #C2740B;
    font-size: 12px;
    font-weight: 600;
}

/* 列头取值筛选浮层（Qt.Popup 顶层控件：只描边界，不加圆角，避免出现黑角） */
QWidget#colFilterPopup {
    background-color: #FFFFFF;
    border: 1px solid #C0CCDA;
}

/* ============================================================
   筛选面板样式模块 (v43.266)
   目标：解决视觉不舒适感，统一间距、配色与布局，提升一致性与用户体验
   ============================================================ */

/* ── 筛选面板整体 ── */
#filterPanel {
    background-color: #F5F8FC;
    color: #101828;
    font-family: inherit;
    font-size: 12px;
    margin: 0;
    padding: 0;
}

/* 内容区域滚动 */
#filterPanel QScrollArea {
    border: none;
    background-color: transparent;
    padding: 4px;
}
#filterPanel QScrollArea::viewport {
    background-color: transparent;
}

/* ── 标题栏 ── */
#filterPanel #title_bar {
    background-color: #FFFFFF;
    border-bottom: 2px solid #E9EEF5;
    padding: 8px 12px;
}
#filterPanel #collapse_btn {
    background-color: transparent;
    border: 1px solid #DBE2EC;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
    min-width: 32px;
    color: #5A6B82;
}
#filterPanel #collapse_btn:hover {
    background-color: #F5F8FC;
    border-color: #C0CCDA;
}
#filterPanel #filterTitleLabel {
    color: #101828;
    font-size: 14px;
    font-weight: 600;
    padding-left: 8px;
}
#filterPanel #preset_btn {
    background-color: #F5F8FC;
    border: 1px solid #DBE2EC;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
    min-width: 60px;
    color: #5A6B82;
}
#filterPanel #preset_btn:hover {
    background-color: #E9EEF5;
    border-color: #C0CCDA;
}

/* ── 分组框 ── */
#filterPanel QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E9EEF5;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: 600;
    font-size: 13px;
    color: #101828;
}
#filterPanel QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #101828;
    font-weight: 600;
}
#filterPanel QGroupBox QFormLayout {
    margin: 8px 0;
    spacing: 10px;
}
#filterPanel QGroupBox QFormLayout::label {
    padding-right: 8px;
    font-weight: 500;
    color: #5A6B82;
    min-width: 100px;
    text-align: right;
    font-size: 12px;
}

/* ── 输入框统一样式 ── */
#filterPanel QLineEdit,
#filterPanel QComboBox,
#filterPanel QDoubleSpinBox,
#filterPanel QDateEdit {
    background-color: #FFFFFF;
    border: 1px solid #DBE2EC;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
    min-height: 32px;
    color: #101828;
}
#filterPanel QLineEdit:hover,
#filterPanel QComboBox:hover,
#filterPanel QDoubleSpinBox:hover,
#filterPanel QDateEdit:hover {
    border-color: #C0CCDA;
}
#filterPanel QLineEdit:focus,
#filterPanel QComboBox:focus,
#filterPanel QDoubleSpinBox:focus,
#filterPanel QDateEdit:focus {
    border-color: #1E40AF;
    outline: none;
    /* box-shadow 不被 Qt QSS 支持（会刷 "Unknown property" 告警），焦点视觉
       反馈改由上方 border-color 高亮承担；如以后要光晕，需用 QPainter 自绘。 */
}
#filterPanel QLineEdit::placeholder {
    color: #8595AA;
}

/* ── 下拉框下拉菜单 ── */
#filterPanel QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #DBE2EC;
    border-radius: 4px;
    selection-background-color: #1E40AF;
    selection-color: #FFFFFF;
    padding: 4px 0;
}
#filterPanel QComboBox::drop-down {
    border: none;
    width: 24px;
}
#filterPanel QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

/* ── 按钮统一样式 ── */
#filterPanel QPushButton {
    background-color: #F5F8FC;
    border: 1px solid #DBE2EC;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
    color: #5A6B82;
    min-width: 70px;
}
#filterPanel QPushButton:hover {
    background-color: #E9EEF5;
    border-color: #C0CCDA;
    color: #101828;
}
#filterPanel QPushButton:pressed {
    background-color: #DBE2EC;
}
#filterPanel QPushButton#reset_filters {
    background-color: #1E40AF;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
    padding: 8px 20px;
}
#filterPanel QPushButton#reset_filters:hover {
    background-color: #1E40AF;
}

/* ── 复选框与单选按钮 ── */
#filterPanel QCheckBox {
    spacing: 6px;
    color: #5A6B82;
    font-size: 12px;
}
#filterPanel QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #C0CCDA;
    border-radius: 4px;
    background-color: #FFFFFF;
}
#filterPanel QCheckBox::indicator:checked {
    background-color: #1E40AF;
    border-color: #1E40AF;
}

/* ── 摘要与提示信息 ── */
#filterPanel #filterNoteLabel {
    background-color: #FDF3E3;
    border: 1px solid #C2740B;
    border-radius: 4px;
    padding: 8px 10px;
    color: #C2740B;
    font-size: 11px;
    margin-top: 8px;
}

/* ── 折叠动画控制 ── */
#filterPanel #content_widget {
    background-color: transparent;
}
#filterPanel #content_widget QGroupBox {
    margin-bottom: 4px;
}

/* ── 特殊控件 ── */
#filterPanel #unit_list {
    max-height: 120px;
    background-color: #FFFFFF;
    border: 1px solid #DBE2EC;
    border-radius: 4px;
    padding: 4px;
}
#filterPanel #unit_clear_btn {
    min-width: 60px;
    background-color: #F5F8FC;
    border: 1px solid #DBE2EC;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

/* ── 工具提示样式 ── */
#filterPanel QToolTip {
    background-color: #101828;
    color: #FFFFFF;
    border: 1px solid #101828;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 11px;
}

/* ── 底部状态条的样式已并入上方「状态栏」段（v43.349 第五期F：一条 QStatusBar）── */
