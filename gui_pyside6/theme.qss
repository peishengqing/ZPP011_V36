/* ZPP011 PySide6 主题样式 */
/* 裴哥 | 2026-06-04 */

QMainWindow {
    background-color: #EEF1F6;
}

QTableView {
    background-color: #ffffff;
    alternate-background-color: #F9F9F9;
    gridline-color: #D8D8D8;
    font-size: 9pt;
    selection-background-color: #1E40AF;
    selection-color: #ffffff;
}

QTableView::item {
    padding: 3px 6px;
    border-bottom: 1px solid #E8E8E8;
}

QTableView::item:selected {
    background-color: #1E40AF;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #E8EAF0;
    padding: 4px 6px;
    border: 1px solid #D1D1D1;
    font-weight: bold;
    font-size: 9pt;
}

QToolBar {
    background-color: #E8E8E8;
    padding: 2px;
    spacing: 4px;
}

QToolBar QPushButton {
    padding: 4px 12px;
    border: 1px solid #C0C0C0;
    border-radius: 4px;
    background-color: #F8F8F8;
    font-size: 9pt;
}

QToolBar QPushButton:hover {
    background-color: #EDF2FF;
    border-color: #1E40AF;
}

QToolBar QPushButton:disabled {
    color: #ADB5BD;
    background-color: #EEF1F6;
}

QComboBox {
    padding: 3px 8px;
    border: 1px solid #C0C0C0;
    border-radius: 4px;
    background-color: #ffffff;
    min-width: 120px;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView::item {
    padding: 4px;
}

QProgressBar {
    border: 1px solid #C0C0C0;
    border-radius: 4px;
    background-color: #EEF1F6;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #1E40AF;
    border-radius: 4px;
}

QStatusBar {
    background-color: #E8E8E8;
    padding: 2px;
    font-size: 9pt;
}

QMenuBar {
    background-color: #E8E8E8;
}

QMenuBar::item:selected {
    background-color: #1E40AF;
    color: #ffffff;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #C0C0C0;
}

QMenu::item:selected {
    background-color: #1E40AF;
    color: #ffffff;
}

QDialog QPushButton {
    padding: 4px 16px;
    border: 1px solid #C0C0C0;
    border-radius: 4px;
    background-color: #F8F8F8;
    min-width: 80px;
}

QDialog QPushButton:hover {
    background-color: #EDF2FF;
}

QInputDialog {
    font-size: 9pt;
}
