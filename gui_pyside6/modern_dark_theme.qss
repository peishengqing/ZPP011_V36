/* 
 *  ZPP011 现代化暗色主题 THEME (2026-10-29 更新)
 *  ------------------------------------------------------------
 *  设计原则：温润感 + 交互式反馈 + 清晰层次
 *  主色调：暖紫 #4C7DFF → #3A66E8 (渐变)
 *  圆角：10px / 12px
 *  交互：前置透出 + 渐变色变化
 */

/* ── 全局基础 ── */
QMainWindow, QDialog, QWidget {
    background-color: #1F1F1C;
    color: #EAE8E4;
    font-family: 'Microsoft YaHei', '.SF NS Text', sans-serif;
    font-size: 13px;
    selection-color: #FFFFFF;
    selection-background-color: #4C7DFF;
}

/* ── 按钮 Button ── */
QPushButton {
    background: linear-gradient(180deg, #4C7DFF 0%, #3A66E8 100%);
    border-radius: 10px;
    padding: 8px 16px;
    min-width: 80px;
    font-weight: 600;
    border: none;
}

QPushButton:hover {
    background: linear-gradient(180deg, #6B93FF 0%, #6B93FF 100%);
    border: 1px solid #6B93FF;
}

QPushButton:pressed {
    background: linear-gradient(180deg, #3A66E8 0%, #3A66E8 100%);
    transform: scale(0.98);
}

QPushButton:disabled {
    background: #555452;
    color: #888888;
}

/* 按钮变体 */
QPushButton#btnPrimary {
    background: linear-gradient(135deg, #4C7DFF 0%, #3A66E8 100%);
}

QPushButton#btnSecondary {
    background-color: #2A2A27;
    border: 1px solid #3E3D38;
    color: #EAE8E4;
}

QPushButton#btnSecondary:hover {
    background-color: #3E3D38;
}

QPushButton#btnSuccess {
    background: linear-gradient(180deg, #10B981 0%, #059669 100%);
}

QPushButton#btnDanger {
    background: linear-gradient(180deg, #E2776D 0%, #C95B52 100%);
}

/* ── 表格 Table & TableView ── */
QHeaderView::section {
    background: linear-gradient(180deg, #4C7DFF 0%, #6B93FF 100%);
    color: #FFFFFF;
    padding: 10px;
    border: none;
    font-weight: 600;
    border-radius: 10px;
    font-family: 'Microsoft YaHei', sans-serif;
}

QTableView::item {
    padding: 8px;
    border: none;
}

QTableView::item:hover {
    background-color: #2E2D28;
    border-radius: 4px;
}

QTableView::item:selected {
    background-color: rgba(139, 125, 212, 0.2);
    border-radius: 4px;
    border: none;
}

QTableView::item:selected:focus {
    background-color: rgba(139, 125, 212, 0.3);
}

/* ── 输入框 Input ── */
QLineEdit, QSpinBox, QComboBox {
    background-color: #2A2A27;
    border: 1px solid #3E3D38;
    border-radius: 10px;
    padding: 8px 12px;
    color: #EAE8E4;
    font-family: 'Microsoft YaHei', monospace;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #4C7DFF;
    outline: none;
}

QLineEdit:hover, QSpinBox:hover, QComboBox:hover {
    border-color: #55544E;
}

QLineEdit::placeholder {
    color: #9A998F;
}

/* ── 标签 Label ── */
QLabel {
    color: #EAE8E4;
    background-color: transparent;
}

/* 标题样式 */
QLabel[fontWeight="bold"], QLabel[font_size="large"] {
    font-weight: 700;
    font-size: 15px;
    color: #FFFFFF;
}

/* ── 滚动条 ScrollBar ── */
QScrollBar:vertical {
    background-color: #232220;
    width: 12px;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #555452;
    border-radius: 6px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #3A66E8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* ── 分组框GroupBox ── */
QGroupBox {
    background-color: #2A2A27;
    border: 1px solid #3E3D38;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: 600;
    font-size: 14px;
    color: #EAE8E4;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    color: #4C7DFF;
}

/* ── 复选框 CheckBox ── */
QCheckBox {
    spacing: 8px;
    color: #EAE8E4;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #3E3D38;
    border-radius: 4px;
    background-color: #2A2A27;
}

QCheckBox::indicator:checked {
    background-color: #4C7DFF;
    border: 1px solid #3A66E8;
}

QCheckBox::indicator:hover {
    border-color: #55544E;
}

/* ── 单选框 RadioButton ── */
QRadioButton {
    spacing: 8px;
    color: #EAE8E4;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #3E3D38;
    border-radius: 10px;
    background-color: #2A2A27;
}

QRadioButton::indicator:checked {
    background-color: #4C7DFF;
    border: 1px solid #3A66E8;
}

/* ── 进度条 ProgressBar ── */
QProgressBar {
    background-color: #2A2A27;
    border: none;
    border-radius: 6px;
    text-align: center;
    font-size: 11px;
    color: #EAE8E4;
}

QProgressBar::chunk {
    background: linear-gradient(180deg, #4C7DFF 0%, #3A66E8 100%);
    border-radius: 6px;
}

/* ── 下拉框(QComboBox、QMenu) ── */
QComboBox QAbstractItemView {
    background-color: #2A2A27;
    color: #EAE8E4;
    border: 1px solid #3E3D38;
    border-radius: 10px;
    selection-background-color: #18254A;
    selection-color: #FFFFFF;
}

QMenu::item {
    background-color: transparent;
    padding: 10px 20px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #18254A;
}

/* ── 标签页 TabWidget ── */
QTabWidget::pane {
    background-color: #2A2A27;
    border: 1px solid #3E3D38;
    border-radius: 10px;
    padding: 12px;
}

QTabBar::tab {
    background-color: #232220;
    padding: 10px 20px;
    margin-right: 4px;
    border-radius: 10px;
    font-weight: 600;
}

QTabBar::tab:selected, QTabBar::tab:hover {
    background-color: #18254A;
    color: #FFFFFF;
}

/* ── 对话框 Dialog ── */
QDialog {
    background-color: #1F1F1C;
}

QDialogButtonBox {
    background-color: transparent;
}

/* ── 状态栏 StatusBar ── */
QStatusBar {
    background-color: #232220;
    color: #9A998F;
}

/* ── 菜单 Menu ── */
QMenuBar {
    background-color: #232220;
    color: #EAE8E4;
    padding: 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 8px 12px;
    border-radius: 6px;
    font-weight: 600;
}

QMenuBar::item:selected {
    background-color: #18254A;
}

/* ── 工具提示 Tooltip ── */
QToolTip {
    background-color: #1F1F1C;
    color: #EAE8E4;
    border: 1px solid #3E3D38;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
    opacity: 240;
}

/* ── 分割器 Splitter ── */
QSplitter::handle {
    background-color: #3E3D38;
    border-radius: 4px;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
    margin: 4px 0;
}

/* ── 数据徽章 ── */
AuditStatusBadge {
    background-color: #F59E0B;
    color: white;
    padding: 4px 12px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

AuditStatusBadge:hover {
    background-color: #D97706;
}

/* ── 自定义类名 ── */
[class*='stat-card'] {
    background-color: #2A2A27;
    border-radius: 10px;
    padding: 16px;
    border-left: 4px solid #4C7DFF;
}
